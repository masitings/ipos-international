            <div class="card-title">{{ pimcore_input('cardTitle1', {'placeholder': 'Drive Business Growth'}) }}</div>
            <div class="card-desc">{{ pimcore_textarea('cardDesc1', {'nl2br': true, 'placeholder': 'Intangible assets account for 90%* of business value and are the primary drivers of enterprise performance and growth.'}) }}</div>
            <div class="card-tip">{{ pimcore_input('cardSubTitle1', {'placeholder': '*Ocean Tomo, LLC Intangible Asset Market Value Study, 2020'}) }}</div>
