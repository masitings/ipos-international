        </div>
      </section>
    </div>
    <section class="sec-subscribe">
      <div class="content"> 
        <div class="tip1">{{pimcore_input('subscribeTitle', {'placeholder': 'Get the Latest IP Trends & Insights'})}}</div>
        <div class="tip2">{{pimcore_input('subscribeDesc', {'placeholder': 'Stay updated with expert insights, industry trends, and exclusive events to help you navigate the world of intangible assets.'})}}</div>
        {% if editmode %}
            <div style="width: 100%;">
                {{pimcore_link('subscriberLink1')}}
            </div>
        {% endif %}
        {% set subscLink = pimcore_link('subscriberLink1') %}
        <a target="_blank" class="btnNow"
            href="{{ subscLink.data.path }}">
            {{ subscLink.data.text }}
        </a>
      </div><img class="img-bg" src="/static/sprint3/images/home_subscribe_bg.3729c80.png" alt="">
    </section>
    <div class="darkCircle">VIEW</div>
    <div class="test"></div>

  <script defer src="/static/sprint3/js/vendor.6410d79.bundle.js"></script><script defer src="/static/sprint3/js/app.bundle.js"></script></body>
