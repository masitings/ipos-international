{% extends 'layouts/layout-20250325.html.twig' %}
{% block css %}
    <link href="/static/static/assets/css/scss/dist/homepage-style.css" rel="stylesheet">
    <link href="/static/static/assets/css/scss/dist/ipos-global.css" rel="stylesheet">
{% endblock %}
{% block content %}
    <section class="academy_overview__page homepage">
        <section class="main-banner">
            <div class="scroll-indicator">SCROLL</div>
            <div class="slider-wrapper">
                <!-- Custom Arrows -->
                <div class="swiper-button-prev">
                    <div class="custom-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none"
                            style="transform: rotate(180deg)">
                            <rect width="39" height="39" x=".5" y=".5" fill="#fff" fill-opacity=".7" rx="19.5" />
                            <rect width="39" height="39" x=".5" y=".5" stroke="#DDD" rx="19.5" />
                            <path stroke="#470A68" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10"
                                stroke-width="1.5" d="m17.375 14.75 5.25 5.25-5.25 5.25" />
                        </svg>
                    </div>
                </div>
                <div class="swiper main-banner-swiper academy-hero-swiper">
                    <div class="swiper-wrapper">
                        {% if editmode %}
                            <div style="margin-top: 30px; margin-left: 20px; margin-right: 20px">
                            <h4>Banner Slider</h4>
                            {{ pimcore_relations('objectsAll',{
                                "types": ["object"],
                                "classes" : [
                                    "HomeImageSlider"
                                ]
                            }) }}
                            </div>
                        {% else %}
                            {% set list = pimcore_relations('objectsAll', { 'orderKey': 'releaseDate', 'order': 'desc' }) %}
                            {% if list is not empty %}
                                {% for carouselItem in list %}
                                {% set videoTitle = carouselItem.getMediaTitle() %}
                                {% set videoThumbnail = carouselItem.getMediaThumbnail() %}
                                {% set videoDescription = carouselItem.getMediaDescription() %}
                                {% set mediaLink = carouselItem.getMediaExternalLink() %}
                                <div class="swiper-slide">
                                    <a href="{{ mediaLink.path|default('/') }}" class="card-wrapper">
                                        <img src="{{ videoThumbnail }}" alt="{{ videoTitle }}" />
                                    </a>
                                    <div class="text-wrapper white">
                                        <div class="title">
                                            {{ videoTitle }}
                                        </div>
                                        <div class="description">
                                            {{ videoDescription }}
                                        </div>
                                        <a href="{{ mediaLink.path|default('/') }}" class="btn">
                                            Find Out More
                                        </a>
                                    </div>
                                </div>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
                <div class="swiper-button-next">
                    <div class="custom-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none">
                            <rect width="39" height="39" x=".5" y=".5" fill="#fff" fill-opacity=".7" rx="19.5" />
                            <rect width="39" height="39" x=".5" y=".5" stroke="#DDD" rx="19.5" />
                            <path stroke="#470A68" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10"
                                stroke-width="1.5" d="m17.375 14.75 5.25 5.25-5.25 5.25" />
                        </svg>
                    </div>
                </div>

                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="trusted-logo-section">
            <div class="container">
                <h3>{{ pimcore_input('homeTitle', { 'placeholder': 'Trusted by leading companies who have benefited from our programmes' })}}</h3>

                <div class="logo-marquee">
                    <div class="logo-track">
                        {% if editmode %}
                            <div style="margin-top: 20px;">
                                {{ pimcore_relations('trustedLogos',{
                                    "types": ["object"],
                                    "height": 200,
                                    "classes" : [
                                        "TrustedLogo"
                                    ]
                                }) }}
                            </div>
                        {% else %}
                            {% set listTrusted = pimcore_relations('trustedLogos', { 'orderKey': 'releaseDate', 'order': 'desc' }) %}
                            {% if listTrusted is not empty %}
                                {% for trusted in listTrusted %}
                                    {% set image = trusted.getImage() %}
                                    <img src="{{ image }}" alt="Trusted Logo" />
                                {% endfor %}
                                {% for trusted in listTrusted %}
                                    {% set image = trusted.getImage() %}
                                    <img src="{{ image }}" alt="Trusted Logo" />
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <section class="why-intangible-assets">
            <div class="credential_content_right"><img src="/static/static/assets/images/credential_right.a13c81c.svg" alt="">
            </div>
            <div class="container">
                <h2 class="section-title">{{ pimcore_input('homeQuestion', {'placeholder': 'Why Intangible Assets?'}) }}</h2>
                <div class="asset-cards">
                    <div class="item-card">
                        <div class="icon">
                            {{ pimcore_image("HomeImage1", {
                                "class": 'img-fluid'
                            }) }}
                        </div>
                        <h3>{{ pimcore_input('cardTitle1', {'placeholder': 'Drive Business Growth'}) }}</h3>
                        <p>
                            {{ pimcore_textarea('cardDesc1', {'nl2br': true, 'placeholder': 'Intangible assets account for 90%* of business value and are the primary drivers of enterprise performance and growth.'}) }}
                        </p>
                        <small><em>{{ pimcore_input('cardSubTitle1', {'placeholder': '*Ocean Tomo, LLC Intangible Asset Market Value Study, 2020'}) }}</em></small>
                    </div>

                    <div class="item-card">
                        <div class="icon">
                            {{ pimcore_image("HomeImage2", {
                                "class": 'img-fluid'
                            }) }}
                        </div>
                        <h3>{{ pimcore_input('cardTitle2', {'placeholder': 'Maximise Value and Profits'}) }}</h3>
                        <p>
                            {{ pimcore_textarea('cardDesc2', {'nl2br': true, 'placeholder': 'Intangible assets contain hidden value and risks that can boost profits and maximise returns when strategically managed well.'}) }}
                        </p>
                    </div>

                    <div class="item-card">
                        <div class="icon">
                            {{ pimcore_image("HomeImage3", {
                                "class": 'img-fluid'
                            }) }}
                        </div>
                        <h3>{{ pimcore_input('cardTitle3', {'placeholder': 'Maximise Value and Profits'}) }}</h3>
                        <p>
                            {{ pimcore_textarea('cardDesc3', {'nl2br': true, 'placeholder': 'Intangible assets allow enterprises to move beyond international borders and scale quickly with the right business and intangible assets strategy.'}) }}
                        </p>
                    </div>
                </div>

                <div class="divide"></div>
            </div>
        </section>
        <section class="explore-section">
            <div class="credential_content_left"><img src="/static/static/assets/images/credential_left.3f3dad0.svg" alt="">
            </div>
            <div class="container courses_tab_content_item active">
                <h2>{{pimcore_input('solutionTitle', {'placeholder': 'Comprehensive Solutions for Your Innovation Journey'})}}</h2>
                <div class="descriptions">
                    {{pimcore_input('solutionDesc', {'placeholder': 'We provide specialized solutions to help businesses and organizations strategize, develop, and analyze their intellectual property and intangible assets.'})}}
                </div>
                <div class="explore-cards row">
                    <!-- Card 1 -->
                    {# <a href="{{ pimcore_link('cardSolution3Link').data.path|default('#') }}" class="courses_tab_content_item_card col-lg-4"> #}
                        <div class="card_image">
                            {{ pimcore_image("cardSolutionImg1", {
                                "height": 1570,
                                "width": 2093,
                                "class": 'cover'
                            }) }}
                        </div>
                        <div class="card_content">
                            <div class="card_content_top">
                                <div class="title">{{pimcore_input('cardSolutionTitle3', {'placeholder': 'Training & Development'})}}</div>
                                <div class="description">
                                    {{pimcore_input('cardSolutionDesc3', {'placeholder': 'Putting together an IP strategy for the first time can seem an intimidating task - here are three simple steps you can take to start the process!'})}}
                                </div>
                            </div>
                            {% if editmode %}
                                {{ pimcore_link('cardSolution3Link') }}
                            {% else %}
                                {% set link = pimcore_link('cardSolution3Link') %}
                                <a class="find-out" target="{{ link.data.target|default('_blank') }}" href="{{ link.data.path|default('#') }}">{{ link.data.text|default('Find out more') }}</a>
                            {% endif %}
                        </div>
                    {# </a> #}
                    
                    <!-- Card 2 -->
                    <a href="{{ pimcore_link('cardSolution1Link').data.path|default('#') }}" class="courses_tab_content_item_card col-lg-4">
                        <div class="card_image">
                            {{ pimcore_image("cardSolutionImg2", {
                                "height": 1570,
                                "width": 2093,
                                "class": 'cover'
                            }) }}
                        </div>
                        <div class="card_content">
                            <div class="card_content_top">
                                <div class="title">{{pimcore_input('cardSolutionTitle1', {'placeholder': 'Training & Development'})}}</div>
                                <div class="description">
                                    {{pimcore_input('cardSolutionDesc1', {'placeholder': 'Putting together an IP strategy for the first time can seem an intimidating task - here are three simple steps you can take to start the process!'})}}
                                </div>
                            </div>
                            {% if editmode %}
                                {{ pimcore_link('cardSolution1Link') }}
                            {% else %}
                                {% set link = pimcore_link('cardSolution1Link') %}
                                <a class="find-out" target="{{ link.data.target|default('_blank') }}" href="{{ link.data.path|default('#') }}">{{ link.data.text|default('Find out more') }}</a>
                            {% endif %}
                        </div>
                    </a>
                    
                    <!-- Card 3 -->
                    <a href="{{ pimcore_link('cardSolution2Link').data.path|default('#') }}" class="courses_tab_content_item_card col-lg-4">
                        <div class="card_image">
                            {{ pimcore_image("cardSolutionImg3", {
                                "height": 1570,
                                "width": 2093,
                                "class": 'cover'
                            }) }}
                        </div>
                        <div class="card_content">
                            <div class="card_content_top">
                                <div class="title">{{pimcore_input('cardSolutionTitle2', {'placeholder': 'Training & Development'})}}</div>
                                <div class="description">
                                    {{pimcore_input('cardSolutionDesc2', {'placeholder': 'Putting together an IP strategy for the first time can seem an intimidating task - here are three simple steps you can take to start the process!'})}}
                                </div>
                            </div>
                            {% if editmode %}
                                {{ pimcore_link('cardSolution2Link') }}
                            {% else %}
                                {% set link = pimcore_link('cardSolution2Link') %}
                                <a class="find-out" target="{{ link.data.target|default('_blank') }}" href="{{ link.data.path|default('#') }}">{{ link.data.text|default('Find out more') }}</a>
                            {% endif %}
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <section class="cta-section container">
            <img src="/static/static/assets/images/strategy-management/IPOS.png" class="img-bg">
            <div class="cta-content-wrapper">
                <div class="cta-content">
                    <h2>{{pimcore_input('subscribeTitle', {'placeholder': 'Get the Latest IP Trends & Insights'})}}</h2>
                    <p>
                        {{pimcore_input('subscribeDesc', {'placeholder': 'Stay updated with expert insights, industry trends, and exclusive events to help you navigate the world of intangible assets.'})}}
                    </p>
                    <div class="cta-buttons">
                        {% if editmode %}
                            <div style="width: 100%;">
                                {{pimcore_link('subscriberLink1')}}
                            </div>
                        {% endif %}
                        {% set subscLink = pimcore_link('subscriberLink1') %}
                        <a target="_blank" class="btn btn-primary"
                            href="{{ subscLink.data.path|default('#') }}">
                            {{ subscLink.data.text|default('Subscribe Now') }}
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </section>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const swiper = new Swiper('.main-banner-swiper', {
                loop: false,
                slidesPerView: 1,
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev'
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                on: {
                    init: function () {
                        toggleArrowState(this);
                    },
                    slideChange: function () {
                        toggleArrowState(this);
                    }
                }
            });

            function toggleArrowState(swiper) {
                const prev = document.querySelector('.swiper-button-prev');
                const next = document.querySelector('.swiper-button-next');

                if (swiper.isBeginning) {
                    prev.classList.add('swiper-button-disabled');
                } else {
                    prev.classList.remove('swiper-button-disabled');
                }

                if (swiper.isEnd) {
                    next.classList.add('swiper-button-disabled');
                } else {
                    next.classList.remove('swiper-button-disabled');
                }
            }
        });
    </script>
{% endblock %}

