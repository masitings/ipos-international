{% extends 'layouts/layout-20250325.html.twig' %}

{% block content %}
    <section class="sec-banner" style="margin-top: 0">
      <div class="content" style="margin-top: 0">
        {% if editmode %}
            <div style="margin-top: 30px; margin-left: 20px; margin-right: 20px">
            <h4>Banner Slider</h4>
            {{ pimcore_relations('objectsAll',{
                "types": ["object"],
                "classes" : [
                    "HomeImageSlider"
                ]
            }) }}
            </div>
        {% else %}
        <div class="swiper swiper_banner">
          <div class="swiper-wrapper">
            {% set list = pimcore_relations('objectsAll', { 'orderKey': 'releaseDate', 'order': 'desc' }) %}
            {% if list is not empty %}
                {% for carouselItem in list %}
                {% set videoTitle = carouselItem.getMediaTitle() %}
                {% set videoThumbnail = carouselItem.getMediaThumbnail() %}
                {% set videoDescription = carouselItem.getMediaDescription() %}
                {% set mediaLink = carouselItem.getMediaExternalLink() %}
                <div class="swiper-slide">
                    <div class="course_content_item">
                        <img class="img-fluid" src="{{ videoThumbnail }}" alt="" contain>
                        <div class="bannerTxt">
                            <div class="bannerTitle">{{ videoTitle }}</div>
                            <div class="bannerDesc">{{ videoDescription }}</div>
                        </div>
                    </div>
                </div>
                {# <div class="img-slider-container" data-title="{{ videoTitle }}" data-description="{{ videoDescription }}" data-description-one="{{ videoDescription1 }}" data-description-two="{{ videoDescription2 }}" data-link="{{mediaLink.path}}" data-position="{{subTitle}}">
                    {% if videoThumbnail %}
                    <img src="{{ videoThumbnail }}" alt="{{ videoTitle }}">
                    {% endif %}
                </div> #}
                {% endfor %}
            {% endif %}
          </div>
          <div class="swiper-pagination"></div>
          <div class="scroll-indicator">
            <div class="txt">SCROLL</div>
            <div class="scroll-indicator-border"> </div>
          </div>
        </div>
        <div class="swiper-button-next"><img src="/static/sprint3/images/icon-banner-arrow-next.d7b7301.png" alt=""></div>
        <div class="swiper-button-prev"><img src="/static/sprint3/images/icon-banner-arrow-next.d7b7301.png" alt=""></div>
        {% endif %}
        {# <div class="swiperTxt">
          <div class="bannerTitle">Ideas Today,<br/>Assets Tomorrow.</div>
          <div class="bannerDesc">Lorem ipsum dolor sit amet consectetur. Amet gravida maecenas augue pulvinar. Amet pretium enim consequat vitae fermentum.</div>
          <div class="btn">Find out more        </div>
        </div> #}
      </div>
    </section>
    <section class="sec-logo-loop">
      <div class="tip">{{ pimcore_input('homeTitle', { 'placeholder': 'Trusted by leading companies who have benefited from our programmes' })}}</div>
      {% if editmode %}
        <div style="margin-top: 20px;">
            {{ pimcore_relations('trustedLogos',{
                "types": ["object"],
                "classes" : [
                    "TrustedLogo"
                ]
            }) }}
        </div>
        {% else %}
        <div class="content-pc">
            <div class="swiper swiper_logo_pc">
                <div class="swiper-wrapper">
                    {% set listTrusted = pimcore_relations('trustedLogos', { 'orderKey': 'releaseDate', 'order': 'desc' }) %}
                    {% if listTrusted is not empty %}
                            {% for trusted in listTrusted %}
                                {% set image = trusted.getImage() %}
                                {# <div class="swiper-slide"> #}
                                <div class="swiper-slide">
                                    <div class="course_content_item"><img class="img-fluid" src="{{ image }}" alt=""></div>
                                </div>
                                {# </div> #}
                            {% endfor %}
                            {% for trusted in listTrusted %}
                                {% set image = trusted.getImage() %}
                                {# <div class="swiper-slide"> #}
                                <div class="swiper-slide">
                                    <div class="course_content_item"><img class="img-fluid" src="{{ image }}" alt=""></div>
                                </div>
                                {# </div> #}
                            {% endfor %}
                    {% endif %}
                </div>
            </div>
            <div class="swiper-button-next"><img src="/static/sprint3/images/icon-arrow-next.e2857c7.png" alt=""></div>
            <div class="swiper-button-prev"><img src="/static/sprint3/images/icon-arrow-prev.7511e68.png" alt=""></div>
        </div>
        <div class="content">
            <div class="swiper swiper_logo">
                <div class="swiper-wrapper">
                    {% set listTrusted = pimcore_relations('trustedLogos', { 'orderKey': 'releaseDate', 'order': 'desc' }) %}
                    {% if listTrusted is not empty %}
                        {% for trusted in listTrusted %}
                            {% set image = trusted.getImage() %}
                            {# <div class="swiper-slide"> #}
                            <div class="swiper-slide">
                                <div class="course_content_item"><img class="img-fluid" src="{{ image }}" alt=""></div>
                            </div>
                            {# </div> #}
                        {% endfor %}
                        {% for trusted in listTrusted %}
                            {% set image = trusted.getImage() %}
                            {# <div class="swiper-slide"> #}
                            <div class="swiper-slide">
                                <div class="course_content_item"><img class="img-fluid" src="{{ image }}" alt=""></div>
                            </div>
                            {# </div> #}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
            <div class="swiper-button-next"><img src="/static/sprint3/images/icon-arrow-next.e2857c7.png" alt=""></div>
            <div class="swiper-button-prev"><img src="/static/sprint3/images/icon-arrow-prev.7511e68.png" alt=""></div>
        </div>
      {% endif %}
    </section>
    <div class="sectionBg"><img class="sectionBg" src="/static/sprint3/images/home_center_bg.3a2c5b3.png" alt="">
      <section class="sec-assets">
