{% extends template_layout_name %}

{% block content %}
<section class="academy_enterprise__page academy-programmes">
    <div class="bg_circle_left"></div>
    <div class="bg_rectangle_left"><img src="/assets/images/enterprise_left.58e9531.svg" alt=""></div>
    <div class="bg_rectangle_right"><img src="/assets/images/enterprise_right.e8293ab.svg" alt=""></div>
    <div class="bg_circle_right"><img src="/assets/images/credential_right.a13c81c.svg" alt=""></div>
    <div class="container">
      <div class="breadcrumb m-b-80">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/academy">Academy</a></li>
          <li class="active">Programmes</li>
        </ol>
      </div>
      <h1 class="m-b-40">Programmes</h1>
      <div class="popupcover"></div>
      <div class="row">
        <div class="col-xl-3 col-12">
          <div class="filter filter-menu mobile">
            <div class="filter-warp hide">
              <div class="filter_head">
                <div class="filter_head_title">
                  <div class="icon_mobile"><img src="/static//images/filter.cd48788.svg" alt=""></div>
                  <div class="text">Filter</div>
                  <div class="filter-number">1</div>
                </div>
                <div class="filter_head_clear">Clear</div>
              </div>
              <div class="filter_body">
                <div class="filter_item search-bar">
                  <div class="search-input-wrapper">
                    <input type="text" placeholder="Search" class="search-input" />
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none">
                      <circle cx="7.215" cy="7.216" r="5.885" stroke="#8C8C8C" stroke-linecap="round"
                        stroke-linejoin="round" stroke-width="1.5" />
                      <path stroke="#8C8C8C" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25"
                        d="m14.669 14.67-3.293-3.293" />
                    </svg>
                  </div>
                </div>
                <div class="filter_item">
                  <select class="js-search-basic-single hide-search" id="programme" name="programme">
                    <option selected disabled value="default">All Programmes</option>
                    <option value="IP Professionals">IP Professionals</option>
                    <option value="Public Agencies / Officers">Public Agencies / Officers</option>
                    <option value="Enterprise / Individuals">Enterprise / Individuals</option>
                    <option value="Graduate Studies">Graduate Studies</option>
                  </select>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                    <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".7"
                      d="m8 10 4 4 4-4" />
                  </svg>
                </div>
                <div class="filter_item">
                  <select class="js-example-basic-single js-search-basic-single list-flex" id="topic" name="topic">
                    <option selected disabled value="default">All Topics</option>
                    <option value="Intangible Assets (IA)">Intangible Assets (IA)</option>
                    <option value="Intellectual Property (IP)">Intellectual Property (IP)</option>
                    <option value="IP Management / Strategy">IP Management / Strategy</option>
                    <option value="Business">Business</option>
                    <option value="Legal">Legal</option>
                  </select>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                    <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".7"
                      d="m8 10 4 4 4-4" />
                  </svg>
                </div>
                <div class="filter_item">
                  <select class="js-search-basic-single hide-search" id="level" name="level">
                    <option selected disabled value="default">All Levels</option>
                    <option value="beginner">Beginner</option>
                    <option value="intermediate">Intermediate</option>
                    <option value="professional">Professional</option>
                  </select>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                    <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".7"
                      d="m8 10 4 4 4-4" />
                  </svg>
                </div>

                <div class="filter_item">
                  <select class="js-search-basic-single hide-search" id="type" name="type">
                    <option selected disabled value="default">All Format</option>
                    <option value="Webinar">Webinar</option>
                    <option value="Seminar">Seminar</option>
                    <option value="Course">Course</option>
                  </select>
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                    <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-opacity=".7"
                      d="m8 10 4 4 4-4" />
                  </svg>
                </div>
                <label class="custom-checkbox">
                  <input type="checkbox" />
                  <span class="checkmark"></span>
                  <span class="label-text">IP Training Pathway for Public Officers</span>
                </label>
              </div>
              <div class="filter_footer_bottom">
                <div class="btn border_orange btn-cancel">Cancel</div>
                <div class="btn full_orange btn-apply">Apply Filter</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xl-9 col-12">
          <div class="course_result">{{ courses|length }} of {{ pagination.totalItems }}<span>courses</span></div>
          <div class="course_content">
            {% for course in courses %}
            <div class="sead-course-card">
              <div class="sead-left">
                <div class="card-wrapper">
                  <img src="{{ course.coverImage }}" alt="Course Image" />
                </div>
              </div>

              <div class="sead-right">
                <div class="tags">
                  <span class="tag">{{ course.eventType }}</span>
                  <span class="tag beginner">{{ course.level }}</span>
                  <span class="tag seminar">{{ course.academyType }}</span>
                </div>

                <h3 class="title">
                  {{ course.title }}
                </h3>

                <div class="date-wrapper">
                  {% if course.planing is defined and course.planing is not empty %}
                    {% for planning in course.planing %}
                      {% if planning.teachingArrangement is defined and planning.teachingArrangement is not empty %}
                        {% for arrangement in planning.teachingArrangement %}
                          <div class="dates">
                            <div class="date-block flex-line">
                              <div class="date-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" fill="none">
                                  <path stroke="#A200D8" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M5.623 2.544v2.251M12.376 2.544v2.251M2.247 7.421h13.506" />
                                  <rect width="13.506" height="12.38" x="2.247" y="3.67" stroke="#A200D8" stroke-linecap="round"
                                    stroke-linejoin="round" stroke-width="1.5" rx="3" />
                                </svg>
                              </div>
                              <div class="date-content">
                                {% if planning.startDate and planning.lastDate %}
                                  {% if planning.startDate == planning.lastDate %}
                                    <p class="date">{{ planning.startDate|date('d M Y') }}</p>
                                  {% else %}
                                    <p class="date">{{ planning.startDate|date('d') }}–{{ planning.lastDate|date('d M Y') }}</p>
                                  {% endif %}
                                {% elseif planning.startDate %}
                                  <p class="date">{{ planning.startDate|date('d M Y') }}</p>
                                {% else %}
                                  <p class="date">Date TBA</p>
                                {% endif %}
                                
                                {% if arrangement.startTime.data is defined and arrangement.lastTime.data is defined %}
                                  <p class="time">{{ arrangement.startTime.data|date('g:i a') }} – {{ arrangement.lastTime.data|date('g:i a') }}</p>
                                {% else %}
                                  <p class="time">Time TBA</p>
                                {% endif %}
                              </div>
                            </div>
                            <div class="date-block flex-line">
                              <div class="date-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" fill="none">
                                  <path stroke="#515B61" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M9 9.047v0a2.25 2.25 0 0 1-2.25-2.25v0A2.25 2.25 0 0 1 9 4.547v0a2.25 2.25 0 0 1 2.25 2.25v0A2.25 2.25 0 0 1 9 9.047Z"
                                    clip-rule="evenodd" />
                                  <path stroke="#515B61" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M9 15.047s-5.25-4.312-5.25-8.25a5.25 5.25 0 1 1 10.5 0c0 3.938-5.25 8.25-5.25 8.25Z"
                                    clip-rule="evenodd" />
                                </svg>
                              </div>
                              <p class="location">
                                {% if arrangement.venue.data is defined %}
                                  {{ arrangement.venue.data }}
                                {% endif %}
                                {% if arrangement.venueText.data is defined and arrangement.venueText.data is not empty %} – {{ arrangement.venueText.data }}{% endif %}
                                {# {% if arrangement.timePlanning is defined and arrangement.timePlanning is not empty %} – {{ arrangement.timePlanning }}{% endif %} #}
                              </p>
                            </div>
                          </div>
                        {% endfor %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    <div class="dates">
                      <div class="date-block flex-line">
                        <div class="date-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" fill="none">
                            <path stroke="#A200D8" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M5.623 2.544v2.251M12.376 2.544v2.251M2.247 7.421h13.506" />
                            <rect width="13.506" height="12.38" x="2.247" y="3.67" stroke="#A200D8" stroke-linecap="round"
                              stroke-linejoin="round" stroke-width="1.5" rx="3" />
                          </svg>
                        </div>
                        <div class="date-content">
                          <p class="date">Date TBA</p>
                          <p class="time">Time TBA</p>
                        </div>
                      </div>
                      <div class="date-block flex-line">
                        <div class="date-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" fill="none">
                            <path stroke="#515B61" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M9 9.047v0a2.25 2.25 0 0 1-2.25-2.25v0A2.25 2.25 0 0 1 9 4.547v0a2.25 2.25 0 0 1 2.25 2.25v0A2.25 2.25 0 0 1 9 9.047Z"
                              clip-rule="evenodd" />
                            <path stroke="#515B61" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M9 15.047s-5.25-4.312-5.25-8.25a5.25 5.25 0 1 1 10.5 0c0 3.938-5.25 8.25-5.25 8.25Z"
                              clip-rule="evenodd" />
                          </svg>
                        </div>
                        <p class="location">Location TBA</p>
                      </div>
                    </div>
                  {% endif %}
                </div>

                <a href="/" class="find-out">
                  Find out more</a>
              </div>
            </div>
            {% endfor %}
          </div>
          <div class="pagination-wrapper">
            <hr />
            <div class="pagination">
              <button class="page-btn">&lt;</button>
              <button class="page-btn">1</button>
              <button class="page-btn">2</button>
              <button class="page-btn active">3</button>
              <button class="page-btn">4</button>
              <button class="page-btn">5</button>
              <button class="page-btn">&gt;</button>
            </div>
            <hr />
          </div>
        </div>
      </div>
      <div class="space-60"></div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $('.js-example-basic-single').select2();
    $('.js-search-basic-single.hide-search').select2({
      minimumResultsForSearch: Infinity
    });

    $('.js-example-basic-single').on('select2:select', function (e) {
      // 做点什么
      console.log(e.params.data)
    });
    $('.js-search-basic-single.hide-search').on('select2:select', function (e) {
      // 做点什么
      console.log(e.params.data)
    });
    let eventArr = [
      new Date('10/23/2021 00:00:00').toDateString(),
      new Date('10/24/2021 00:00:00').toDateString(),
      new Date('11/01/2021 00:00:00').toDateString(),
      new Date('11/05/2021 00:00:00').toDateString()
    ]


    $('.filter.filter-menu .filter_head').on('click', function (e) {
      if ($(e.target).hasClass('filter_head_clear')) {
        return
      }
      var windowsize = $(window).width();
      if (windowsize <= 1200) {
        if ($('.filter.mobile .filter-warp').hasClass('hide')) {
          $('.filter.mobile .filter-warp').removeClass('hide')
          $('.filter.mobile .filter-warp').addClass('active')
          $('.classnames, .popupcover').addClass('active')

        } else {
          $('.filter.mobile .filter-warp').removeClass('active').addClass('hide')
          $('.filter.mobile .filter_head').addClass('active')
          $('.classnames, .popupcover').removeClass('active')
        }
      }
    })
    $('.filter.filter-menu .btn-cancel, .filter.filter-menu .btn-apply').on('click', function (e) {
      $('.filter.mobile .filter-warp').removeClass('active').addClass('hide')
      $('.classnames, .popupcover').removeClass('active')
    })

    

    $('.filter.mobile  .filter_head .filter_head_clear').click(function () {
      $('.js-example-basic-single').val('default')
      $('.js-search-basic-single.hide-search').val('default')
      $('.js-example-basic-single').trigger('change');
      $('.js-search-basic-single.hide-search').trigger('change');

    })
    $('.filter .filter_head .filter_head_clear').on('click', function () {
      $('.js-example-basic-single').val('default')
      $('.js-search-basic-single.hide-search').val('default')
      $('.js-example-basic-single').trigger('change');
      $('.js-search-basic-single.hide-search').trigger('change');
    })

    $('.filter.mobile .btn-cancel, .filter.mobile .btn-apply').on('click', function () {
      if (windowsize <= 1200) {
        if ($('.filter.mobile').hasClass('active')) {
          $('.filter.mobile').removeClass('active')
          $('.filter.mobile').addClass('hide')
        }
      }
    })

  </script>
{% endblock %}