{% extends template_layout_name %}

{% do document.setTitle(detail.seoTitle | default(detail.title ~ ' ? IPOS International')) %}
{% do pimcore_head_meta().setName("description", detail.seoDescription | default(detail.content | striptags | u.truncate(320))) %}
{% do pimcore_head_meta().setName("keywords", detail.tags | default('')) %}

{% block content %}
<section class="articles_details_container resources_public_container ip-capabilities academy-details">
    <section class="detail">
        <div class="bg_circle"></div>
		<div class="resources_public_title_nav container">
            <div class="row">
                <div class="col-12">
                    <nav class="nav-view" aria-label="breadcrumb" style="--bs-breadcrumb-divider: '&gt;';">
                        <ol class="breadcrumb col-12">
                            <li class="breadcrumb-item d-none d-md-block">
		                        <a href="/">{{ 'Home'|trans }}</a>
							</li>
                            <li class="breadcrumb-item d-none d-md-block">
								<a href="{{ pimcore_document(6).fullpath }}">Academy</a>
							</li>
                            <li class="breadcrumb-item d-none d-md-block">
								<a href="{{ pimcore_document(6).fullpath }}/{{ detail.urlType }}">{{ detail.academyType }}</a>
							</li>

                            <li class="breadcrumb-item d-none d-md-block active" aria-current="page">{{ detail.title }}</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
		<div class="academy_enterprise_detail__page">
			<div class="container detail-academy">
				<div class="row main-articles">
					<div class="col-xl-8 col-lg-12 col-12 padding-right-90">
						<div class="header-part">
							<div class="tags">
								<span class="tag">{{ detail.eventType }}</span>
								<span class="tag beginner">{{ detail.level }}</span>
								<span class="tag seminar">{{ detail.academyType }}</span>
								<span class="tag topic">{{ detail.topic }}</span>
							</div>
							<h1>{{ detail.title }}</h1>
						</div>

						<div class="content-container ic-content">
							{{ detail.content | raw}}

							{% if detail.partner is not empty %}
							<div class="edition-highlights">
								<div class="partners">
									<p class="label">Partner Organisation</p>
									<div class="logos-wrap">
										<div class="logos">
											{% for partner in detail.partner %}
												<img src="{{ partner.image }}" alt="{{ partner.name }}" />
											{% endfor %}
										</div>
									</div>
								</div>
							</div>
							{% endif %}
						</div>
					</div>
					<div class="col-12 d-block d-md-none">
					</div>
					<div class="col-lg-4 col-12 detail right-side-contact">
						<div class="wrap-right-side-sticky">
							<div class="detail_right">
								<div class="detail_right_circle">
									<div class="circle left"></div>
									<div class="circle right"></div>
								</div>
								<div class="detail_info_content">
									<div class="programme-card">
										<h3 class="heading">Programme Information</h3>
										{# DATE TIME #}
										{% if detail.planning is defined and detail.planning is not empty %}
											{% for planning in detail.planning %}
												{% if planning.teachingArrangement is defined and planning.teachingArrangement is not empty %}
													{% for arrangement in planning.teachingArrangement %}
														<div class="info-item">
															<span class="icon">
																<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none">
																	<path stroke="#fff" stroke-linecap="round" stroke-linejoin="round"
																		stroke-width="1.25"
																		d="M5.623 2.247v2.251M12.376 2.247v2.251M2.247 7.124h13.506" />
																	<rect width="13.506" height="12.38" x="2.247" y="3.373"
																		stroke="#fff" stroke-linecap="round" stroke-linejoin="round"
																		stroke-width="1.25" rx="3" />
																</svg>
															</span>
															<span class="text">
																{% if planning.startDate and planning.lastDate %}
																	{% if planning.startDate == planning.lastDate %}
																		{{ planning.startDate|date('d M Y') }}
																	{% else %}
																		{{ planning.startDate|date('d') }}–{{ planning.lastDate|date('d M Y') }}
																	{% endif %}
																{% elseif planning.startDate %}
																	{{ planning.startDate|date('d M Y') }}
																{% else %}
																	Date TBA
																{% endif %}
																{% if arrangement.startTime.data is defined and arrangement.lastTime.data is defined %}
																	, {{ arrangement.startTime.data|date('g:i a') }} – {{ arrangement.lastTime.data|date('g:i a') }}
																{% else %}
																	, Time TBA
																{% endif %}
															</span>
														</div>
														<div class="info-item">
															<span class="icon">
																<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
																	fill="none">
																	<path stroke="#C8B5D2" stroke-linecap="round"
																		stroke-linejoin="round" stroke-width="1.25"
																		d="M9 8.75v0A2.25 2.25 0 0 1 6.75 6.5v0A2.25 2.25 0 0 1 9 4.25v0a2.25 2.25 0 0 1 2.25 2.25v0A2.25 2.25 0 0 1 9 8.75Z"
																		clip-rule="evenodd" />
																	<path stroke="#C8B5D2" stroke-linecap="round"
																		stroke-linejoin="round" stroke-width="1.25"
																		d="M9 14.75S3.75 10.437 3.75 6.5a5.25 5.25 0 1 1 10.5 0c0 3.938-5.25 8.25-5.25 8.25Z"
																		clip-rule="evenodd" />
																</svg>
															</span>
															<span class="text grey">
																{% if arrangement.venue.data is defined %}
																	{{ arrangement.venue.data }}
																{% endif %}
																{% if arrangement.venueText.data is defined and arrangement.venueText.data is not empty %}
																	– {{ arrangement.venueText.data }}
																{% endif %}
															</span>
														</div>
													{% endfor %}
												{% endif %}
											{% endfor %}
										{% endif %}
