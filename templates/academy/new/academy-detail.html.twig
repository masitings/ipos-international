														clip-rule="evenodd" />
												</svg></span>
											{% if detail.contacts is defined and detail.contacts is not empty %}
												{% set firstContact = detail.contacts|first %}
												<span class="text">Contact {{ firstContact.contactName.data }}: {{ firstContact.contactMobile.data }}</span>
											{% endif %}
										</div>

										<div class="info-item link">
											<span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="18"
													height="18" fill="none">
													<path stroke="#fff" stroke-linecap="round" stroke-linejoin="round"
														stroke-opacity=".7" d="M6 9.75h6M6 12.75h6" />
													<path stroke="#fff" stroke-linecap="round" stroke-linejoin="round"
														stroke-opacity=".7"
														d="M4.5 2.25h6.879a1.5 1.5 0 0 1 1.06.44l2.121 2.12A1.5 1.5 0 0 1 15 5.872v8.379a1.5 1.5 0 0 1-1.5 1.5h-9a1.5 1.5 0 0 1-1.5-1.5V3.75a1.5 1.5 0 0 1 1.5-1.5Z"
														clip-rule="evenodd" />
													<path stroke="#fff" stroke-linecap="round" stroke-linejoin="round"
														stroke-opacity=".7"
