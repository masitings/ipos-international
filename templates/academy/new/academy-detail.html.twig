												</svg></span>
											<a href="#program-details" class="text">View Program Details</a>
										</div>

										<a class="btn-register" href="{{ detail.interestedRegister.path }}">Register Here</a>
										{% if detail.manual is not empty and detail.manual2 is not empty %}
											<div class="brochure-dropdown">
												<button class="brochure-button" onclick="toggleDropdown()">
													<span>Download Brochure /<br />IP Training Pathway for Public Officers</span>
													<span class="arrow">
														<svg xmlns="http://www.w3.org/2000/svg" width="12" height="13" fill="none">
															<path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 4.25 6 8.75l-4.5-4.5" />
														</svg>
													</span>
												</button>

												<div class="dropdown-list" id="dropdownList">
													<a target="_blank" href="{{ detail.manual.path }}" class="dropdown-item">Brochure</a>
													<a target="_blank" href="{{ detail.manual2.path }}" class="dropdown-item">Training Pathways Course</a>
												</div>
											</div>
										{% else %}
											{% if detail.manual is not empty %}
											<a target="_blank" href="{{ detail.manual.path }}" class="brochure-button single">
												<span>Download Brochure</span>
											</a>
											{% elseif detail.manual2 is not empty %}
											<a target="_blank" href="{{ detail.manual2.path }}" class="brochure-button single">
												<span>Download Training Pathways</span>
											</a>
											{% else %}
											<div></div>
											{% endif %}
										{% endif %}

										<ul class="additional-info">
											{% for text in detail.pendant %}
												<li>{{ text.text.data }}</li>
											{% endfor %}
										</ul>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

