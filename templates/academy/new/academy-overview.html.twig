{% extends template_layout_name %}

{% block content %}
<section class="academy_overview__page academy-overview">
    <section class="about">
        <div class="about_bg_circle"></div>
        <div class="about_bg_ipos"><img src="/static/static/assets/images/IPOS.d59bcba.svg" alt=""></div>
        <div class="container about_content">
            <div class="breadcrumb m-b-80">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li class="/academy">Academy</li>
                    <li class="active">Overview</li>
                </ol>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <h1>{{pimcore_input('academyTitle', {'placeholder': 'Featured Programmes'})}}</h1>
                    <div class="slider-wrapper">

                        <!-- Custom Arrows -->
                        <div class="swiper-button-prev">
                            <div class="custom-arrow">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none"
                                    style="transform: rotate(180deg)">
                                    <rect width="39" height="39" x=".5" y=".5" fill="#fff" fill-opacity=".7"
                                        rx="19.5" />
                                    <rect width="39" height="39" x=".5" y=".5" stroke="#DDD" rx="19.5" />
                                    <path stroke="#470A68" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-miterlimit="10" stroke-width="1.5"
                                        d="m17.375 14.75 5.25 5.25-5.25 5.25" />
                                </svg>
                            </div>
                        </div>
                        {% if editmode %}
                            {{ pimcore_relations('sliderData',{
                                "types": ["object"],
                                "classes" : [
                                    "Course"
                                ]
                            }) }}
                        {% else %}
                        <div class="swiper mySwiper academy-hero-swiper">
                            <div class="swiper-wrapper">
                                <!-- Slides -->
                                {% set sliderData = pimcore_relations('sliderData',{}) %}
                                {% for course in sliderData %}
                                    {% set image = course.getCoverImage() %}
                                    {% set link = course.getInterestedRegister() %}
                                    {% set topic = course.getTopic() %}
                                    {% set level = course.getLevel() %}
                                    {% set eventType = course.getEventType() %}
                                    <div class="swiper-slide">
                                        <div class="sead-course-card">
                                            <div class="sead-left">
                                                <div class="card-wrapper">
                                                    <img src="{{image}}"
                                                        alt="Course Image" />
                                                </div>
                                            </div>

                                            <div class="sead-right">
                                                <div class="tags">
                                                    <span class="tag">{{topic}}</span>
                                                    <span class="tag beginner">{{level}}</span>
                                                    <span class="tag seminar">{{eventType}}</span>
                                                </div>

                                                <h3 class="title">
                                                    {{ course.getTitle() }}
                                                </h3>

                                                <div class="download-link">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                        fill="none">
                                                        <path stroke="#470A68" stroke-linecap="round"
                                                            stroke-linejoin="round" stroke-width="1.25"
                                                            d="M15.345 5.345 12.99 2.988A1.667 1.667 0 0 0 11.81 2.5H5.834c-.921 0-1.667.746-1.667 1.667v11.666c0 .921.746 1.667 1.667 1.667h8.333c.92 0 1.667-.746 1.667-1.667v-9.31c0-.441-.176-.865-.489-1.178v0Z"
                                                            clip-rule="evenodd" />
                                                        <path stroke="#470A68" stroke-linecap="round"
                                                            stroke-linejoin="round" stroke-width="1.25"
                                                            d="M15.834 6.667H12.5a.834.834 0 0 1-.833-.834V2.5M8.617 13.792h2.767" />
                                                        <path stroke="#470A68" stroke-linecap="round"
                                                            stroke-linejoin="round" stroke-width="1.25"
                                                            d="M9.027 10.626v-.974c0-.268.218-.485.486-.485h.973c.269 0 .486.217.486.485v.974a.486.486 0 0 1-.486.486h-.973a.487.487 0 0 1-.486-.486ZM6.667 14.514v-.973c0-.268.217-.486.486-.486h.973c.268 0 .486.218.486.486v.973a.486.486 0 0 1-.486.486h-.973a.486.486 0 0 1-.486-.486ZM11.39 14.514v-.973c0-.268.217-.486.486-.486h.973c.268 0 .486.218.486.486v.973a.487.487 0 0 1-.487.486h-.973a.486.486 0 0 1-.485-.486h0Z"
                                                            clip-rule="evenodd" />
                                                        <path stroke="#470A68" stroke-linecap="round"
                                                            stroke-linejoin="round" stroke-width="1.25"
                                                            d="m11.867 13.058-1.259-1.966M8.134 13.058l1.258-1.966" />
                                                    </svg>
                                                    {% if link is not empty %}
                                                        <a href="{{link.path}}" target="{{link.target}}">{{link.text}}</a>
                                                    {% endif %}
                                                </div>

                                                <div class="dates">
                                                    {% if course.getPlaning() is not empty %}
                                                        {% for planning in course.getPlaning() %}
                                                            {% if planning.getTeachingArrangement() is not empty %}
                                                                {% for arrangement in planning.getTeachingArrangement() %}
                                                                    <div class="date-block">
                                                                        {% if planning.getStartDate() and planning.getLastDate() %}
                                                                            {% if planning.getStartDate() == planning.getLastDate() %}
                                                                                <p class="date">{{ planning.getStartDate()|date('d M Y') }}</p>
                                                                            {% else %}
                                                                                <p class="date">{{ planning.getStartDate()|date('d') }}–{{ planning.getLastDate()|date('d M Y') }}</p>
                                                                            {% endif %}
                                                                        {% elseif planning.getStartDate() %}
                                                                            <p class="date">{{ planning.getStartDate()|date('d M Y') }}</p>
                                                                        {% endif %}
                                                                        
                                                                        {% if arrangement.startTime.getData() and arrangement.lastTime.getData() %}
                                                                            <p class="time">{{ arrangement.startTime.getData()|date('g:i a') }} – {{ arrangement.lastTime.getData()|date('g:i a') }}</p>
                                                                        {% endif %}
                                                                        
                                                                            <p class="location">
                                                                                {% if arrangement.venue.getData() %}
                                                                                {{ arrangement.venue.getData() }}
                                                                                {% endif %}
                                                                                {% if arrangement.venueText.getData() %} – {{ arrangement.venueText.getData() }}{% endif %}
                                                                                {% if arrangement.timePlanning %} – {{ arrangement.timePlanning }}{% endif %}
                                                                            </p>
                                                                    </div>
                                                                {% endfor %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <div class="date-block">
                                                            <p class="date">Date TBA</p>
                                                            <p class="time">Time TBA</p>
                                                            <p class="location">Location TBA</p>
                                                        </div>
                                                    {% endif %}
                                                </div>

                                                <a href="{{ course }}_{{ course.getId() }}" class="arrow">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="61"
                                                        fill="none">
                                                        <path stroke="#470A68" stroke-linecap="round"
                                                            stroke-linejoin="round" stroke-width="1.5"
                                                            d="M47.5 30.486h-35M35 42.986l12.5-12.5M35 17.986l12.5 12.5" />
                                                    </svg>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        <div class="swiper-button-next">
                            <div class="custom-arrow">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none">
                                    <rect width="39" height="39" x=".5" y=".5" fill="#fff" fill-opacity=".7"
                                        rx="19.5" />
                                    <rect width="39" height="39" x=".5" y=".5" stroke="#DDD" rx="19.5" />
                                    <path stroke="#470A68" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-miterlimit="10" stroke-width="1.5"
                                        d="m17.375 14.75 5.25 5.25-5.25 5.25" />
                                </svg>
                            </div>
                        </div>

                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

