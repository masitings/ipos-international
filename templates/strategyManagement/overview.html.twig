                        <div transition: ease-in-out 0.1s all;
                            class="courses_tab_content_item_card col-lg-6">
                            <div class="card_image strategy_overview_img_card">
                                {{ pimcore_image("cardImg1", {
                                    "height": 1570,
                                    "width": 2093
                                }) }}
                            </div>
                            <div class="card_content">
                                <div class="card_content_top">
                                    <div class="title">{{pimcore_input('card1', {'placeholder': 'Build IP Capabilities'})}}</div>
                                    <div class="description">
                                        {{  pimcore_wysiwyg("card1desc", {
                                                "height": 200,
                                                "placeholder" : "Add content..."
