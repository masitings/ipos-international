                            </div>
                        </div> #}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Explore Section -->
    <section class="explore-section">
        <div class="container courses_tab_content_item active">
            <h2>{{ pimcore_input('exploremore', {'placeholder': 'Explore'}) }}</h2>
            <div class="explore-cards row">
                <!-- Card 1: Our People & Culture -->
                {% if editmode %}
                {{ pimcore_link('cardExploreLink1') }}
                {{ pimcore_link('cardExploreLink2') }}
                {% endif %}
                {% set linkExplore1 = pimcore_link('cardExploreLink1') %}
                {% set linkExplore2 = pimcore_link('cardExploreLink2') %}
                

                <div transition: ease-in-out 0.1s all; class="courses_tab_content_item_card col-lg-6">
                    <div class="card_image strategy_overview_img_card">
                        {{ pimcore_image('cardExploreImage1',{
                            "height": 1570,
                            "width": 2093
                        }) }}
                    </div>
                    <div class="card_content">
                        <div class="card_content_top">
                            <div class="title">{{ pimcore_input('cardExplore1Title', {'placeholder': 'News & Announcements'}) }}</div>
                            <div class="description">
                                {{  pimcore_wysiwyg("cardExplore1Desc", {
                                    "height": 200,
                                    "placeholder" : "Add content..."
                                })
                            }}
                            </div>
                        </div>
                        <a href="{{linkExplore1.data.path}}" class="find-out">
                            Find out more</a>
