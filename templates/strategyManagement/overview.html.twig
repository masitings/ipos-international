                                }) }}
                            </div>
                            <div class="card_content">
                                <div class="card_content_top">
                                    <div class="title">{{pimcore_input('card2', {'placeholder': 'Consultation'})}}</div>
                                    <div class="description">
                                        {{  pimcore_wysiwyg("card2desc", {
                                                "height": 200,
                                                "placeholder" : "Add content..."
                                            })
                                        }}
                                    </div>
                                </div>
                                {{ pimcore_link('card2Link',{
                                    'noText' : true,
                                    'class' : 'find-out',
                                    'textSuffix' : '<span class="find-out">Find out more</span>'
                                }) }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-panel" id="accelerators">
                    <div class="explore-cards row">
                        <!-- Card 1: Our People & Culture -->
                        <div transition: ease-in-out 0.1s all;
                            class="courses_tab_content_item_card col-lg-6">
                            <div class="card_image strategy_overview_img_card">
                                {{ pimcore_image("cardImg1A", {
                                    "height": 1570,
                                    "width": 2093
                                }) }}
                            </div>
                            <div class="card_content">
                                <div class="card_content_top">
                                    <div class="title">{{pimcore_input('card1A', {'placeholder': 'Build IP Capabilities'})}}</div>
                                    <div class="description">
                                        {{  pimcore_wysiwyg("card1Adesc", {
                                                "height": 200,
                                                "placeholder" : "Add content..."
                                            })
                                        }}
                                    </div>
                                </div>
                                {{ pimcore_link('card1ALink',{
                                    'noText' : true,
                                    'class' : 'find-out',
                                    'textSuffix' : '<span class="find-out">Find out more</span>'
                                }) }}
                            </div>
                        </div>
                        <div class="col-lg-6" style="
                            border-radius: 8px;
                            overflow: hidden;
                            padding: 12px 24px 12px 0;
                            position: relative;
                            flex: 1 1 calc(50% - 15px);
                            box-sizing: border-box;
                            display: block;">&nbsp;</div>
