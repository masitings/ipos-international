        <div class="container courses_tab_content_item active">
            <h2>{{ pimcore_input('solution', {'placeholder': 'Solutions for Every Innovator'}) }}</h2>

            <div class="tabs">
                <button class="tab-button active" data-tab="enterprises">Enterprises</button>
