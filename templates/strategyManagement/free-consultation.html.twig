<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".wrap-right-side-sticky");
        const sidebarContainer = document.querySelector(".col-lg-4.col-12.detail.right-side-contact");
        const mainContainer = document.querySelector(".main-articles");

        if (!sidebar || !sidebarContainer || !mainContainer) return;

        function updateStickySidebar() {
            const containerRect = sidebarContainer.getBoundingClientRect();
            const sidebarHeight = sidebar.offsetHeight;
            const containerHeight = sidebarContainer.offsetHeight;

            const offsetTop = mainContainer.offsetTop; // Top position of main container
            const stopPoint = offsetTop + containerHeight - sidebarHeight; // Bottom stop position

            if (window.scrollY > offsetTop - 322 && window.scrollY < stopPoint) {
                // Make sidebar fixed while scrolling
                sidebar.style.position = "fixed";
                sidebar.style.top = "280px";
                sidebar.style.bottom = "auto";
            } else if (window.scrollY >= stopPoint) {
                // Lock sidebar at the bottom of its container
                sidebar.style.position = "absolute";
                sidebar.style.top = "auto";
                sidebar.style.bottom = "156px";
            } else {
                // Reset when scrolling back up
                sidebar.style.position = "static";
                sidebar.style.top = "auto";
                sidebar.style.bottom = "auto";
            }
        }

        window.addEventListener("scroll", updateStickySidebar);
        window.addEventListener("resize", updateStickySidebar);
        updateStickySidebar(); // Initial run
    });




    $(document).ready(function () {
        // Handle Section-Image Logic
        const handleSectionImage = () => {
            const videoContainer = $("#section-image .video-container");
            const thumbnails = $("#section-image .img-slider-container");
            const thumbnailCarousel = $("#section-image .thumbnail-carousel");
            const arrowLeft = $("#section-image .arrow-left");
            const arrowRight = $("#section-image .arrow-right");
            const thumbnailWidth = thumbnails.outerWidth(true);
            const visibleThumbnails = 3;
            let currentSlide = 0;

            const updateVideoContent = (thumbnail) => {
                const iframe = thumbnail.find("iframe");
                const img = thumbnail.find("img");

                // Clear previous content in the video container
                videoContainer.empty();

                if (iframe.length) {
                    // If the thumbnail contains an iframe (video)
                    const clonedIframe = iframe.clone();
                    clonedIframe.removeClass("d-none"); // Remove the hidden class
                    videoContainer.append(clonedIframe); // Append the iframe
                } else if (img.length) {
                    // If the thumbnail contains an image
                    videoContainer.append(img.clone());
                }
            };

            function updateArrowState() {
                arrowLeft.prop("disabled", currentSlide === 0);
                arrowRight.prop(
                    "disabled",
                    currentSlide >= thumbnails.length - visibleThumbnails
                );
            }

            thumbnails.click(function () {
                thumbnails.removeClass("active");
                $(this).addClass("active");
                updateVideoContent($(this));
            });

            thumbnailCarousel.on('mousedown touchstart', function (e) {
                isDragging = true;
                startX = e.pageX || e.originalEvent.touches[0].pageX;
                scrollLeft = thumbnailCarousel.scrollLeft();
            });

            arrowLeft.click(function () {
                if (currentSlide > 0) {
                    currentSlide--;
                    thumbnailCarousel.animate({ scrollLeft: currentSlide * thumbnailWidth }, 300);
                    updateArrowState();
                }
            });

            arrowRight.click(function () {
                if (currentSlide < thumbnails.length - visibleThumbnails) {
                    currentSlide++;
                    thumbnailCarousel.animate({ scrollLeft: currentSlide * thumbnailWidth }, 300);
                    updateArrowState();
                }
            });

            thumbnails.first().click();
            updateArrowState();
        };

        // Handle Main-Articles Section-2 Logic
        const handleMainArticlesSection2 = () => {
            const videoContainer = $("#main-articles-section-2 .video-container");
            const thumbnails = $("#main-articles-section-2 .img-slider-container");
            const thumbnailCarousel = $("#main-articles-section-2 .thumbnail-carousel");
            const arrowLeft = $("#main-articles-section-2 .arrow-left");
            const arrowRight = $("#main-articles-section-2 .arrow-right");
            const textContainer = $("#main-articles-section-2 .text-container");
            const textContentWrapper = $("#main-articles-section-2 .text-content");
            const textLinkContainer = $("#main-articles-section-2 .text-container .text-container-button");
            const thumbnailWidth = thumbnails.outerWidth(true);
            const visibleThumbnails = 3;
            let currentSlide = 0;
            let isDragging = false;
            let startX;
            let scrollLeft;

            const updateVideoContent = (thumbnail) => {
                const iframe = thumbnail.find("iframe");
                const img = thumbnail.find("img");

                // Clear previous content in the video container
                videoContainer.empty();

                if (iframe.length) {
                    // If the thumbnail contains an iframe (video)
                    const clonedIframe = iframe.clone();
                    clonedIframe.removeClass("d-none"); // Remove the hidden class
                    videoContainer.append(clonedIframe); // Append the iframe
                } else if (img.length) {
                    // If the thumbnail contains an image
                    videoContainer.append(img.clone());
                }

                // Update the text-container content
                const title = thumbnail.data("title") || "Default Title";
                const description = thumbnail.data("description") || "Default Description";
                const description1 = thumbnail.data("description-one") || "";
                const description2 = thumbnail.data("description-two") || "";
                const subtitle = thumbnail.data("position") || "";
                const link = thumbnail.data("link") || "";
                textContainer.find("h2").text(title);
                textContainer.find("p").text(description);
                textContainer.find("h4").text(subtitle);
                textContentWrapper.find("p:not(:first)").remove();

                if (description1) {
                    textContentWrapper.append(`<p style="margin-top: 10px">${description1}</p>`);
                }
                if (description2) {
                    textContentWrapper.append(`<p style="margin-top: 10px">${description2}</p>`);
                }
                // Ensure `textLinkContainer` exists and `link` is not empty
                if (link) {
                    // Remove existing link first (to prevent duplicates)
                    textLinkContainer.find(".button-1").remove();

                    // Append new link
                    textLinkContainer.append(
                        $('<a>', {
                            class: "button-1",
                            href: link,
                            text: "Find out more"
                        })
                    );
                } else {
                    textLinkContainer.find(".button-1").remove();
                }
            };

            const updateArrowState = () => {
                arrowLeft.toggle(currentSlide > 0);
                arrowRight.toggle(currentSlide < thumbnails.length - visibleThumbnails);
            };

            thumbnails.click(function () {
                thumbnails.removeClass("active");
                $(this).addClass("active");
                updateVideoContent($(this));
            });

            arrowLeft.click(function () {
                if (currentSlide > 0) {
                    currentSlide--;
                    thumbnailCarousel.animate({ scrollLeft: currentSlide * thumbnailWidth }, 300);
                    updateArrowState();
                }
            });

            arrowRight.click(function () {
                if (currentSlide < thumbnails.length - visibleThumbnails) {
                    currentSlide++;
                    thumbnailCarousel.animate({ scrollLeft: currentSlide * thumbnailWidth }, 300);
                    updateArrowState();
                }
            });

            // Dragging functionality
            thumbnailCarousel.on('mousedown touchstart', (e) => {
                isDragging = true;
                startX = e.pageX || e.originalEvent.touches[0].pageX;
                scrollLeft = thumbnailCarousel.scrollLeft();
            });

            thumbnailCarousel.on('mousemove touchmove', (e) => {
                if (!isDragging) return;
                const x = e.pageX || e.originalEvent.touches[0].pageX;
                const walk = (startX - x) * 2;
                thumbnailCarousel.scrollLeft(scrollLeft + walk);
            });

            thumbnailCarousel.on('mouseup touchend', () => {
                isDragging = false;
            });

            // Trigger click on the first thumbnail to initialize content
            thumbnails.first().click();
            updateArrowState();
        };

        const handleMainArticlesSection3 = () => {
            const videoContainer = $("#main-articles-section-3 .video-container");
            const thumbnails = $("#main-articles-section-3 .img-slider-container");
            const thumbnailCarousel = $("#main-articles-section-3 .thumbnail-carousel");
            const arrowLeft = $("#main-articles-section-3 .arrow-left");
            const arrowRight = $("#main-articles-section-3 .arrow-right");
            const textContainer = $("#main-articles-section-3 .text-container");
            const textContentWrapper = $("#main-articles-section-3 .text-content");
            const textLinkContainer = $("#main-articles-section-3 .text-container .text-container-button");
            const thumbnailWidth = thumbnails.outerWidth(true);
            const visibleThumbnails = 3;
            let currentSlide = 0;
            let isDragging = false;
            let startX;
            let scrollLeft;

            const updateVideoContent = (thumbnail) => {
                const iframe = thumbnail.find("iframe");
                const img = thumbnail.find("img");

                // Clear previous content in the video container
                videoContainer.empty();

                if (iframe.length) {
                    // If the thumbnail contains an iframe (video)
                    const clonedIframe = iframe.clone();
                    clonedIframe.removeClass("d-none"); // Remove the hidden class
                    videoContainer.append(clonedIframe); // Append the iframe
                } else if (img.length) {
                    // If the thumbnail contains an image
                    videoContainer.append(img.clone());
                }

                // Update the text-container content
                const title = thumbnail.data("title") || "Default Title";
                const position = thumbnail.data("position") || "";
                const description = thumbnail.data("description") || "Default Description";
                const link = thumbnail.data("link") || "";
                const description1 = thumbnail.data("description-one") || "";
                const description2 = thumbnail.data("description-two") || "";
                textContainer.find("h2").text(title);
                textContainer.find("p").text(description);
                textContainer.find("h4").text(position);
                textContentWrapper.find("p:not(:first)").remove();

                if (description1) {
                    textContentWrapper.append(`<p style="margin-top: 10px">${description1}</p>`);
                }
                if (description2) {
                    textContentWrapper.append(`<p style="margin-top: 10px">${description2}</p>`);
                }

                // Ensure `textLinkContainer` exists and `link` is not empty
                if (link) {
                    // Remove existing link first (to prevent duplicates)
                    textLinkContainer.find(".button-1").remove();

                    // Append new link
                    textLinkContainer.append(
                        $('<a>', {
                            class: "button-1",
                            href: link,
                            text: "Find out more"
                        })
                    );
                } else {
                    textLinkContainer.find(".button-1").remove();
                }
            };

            const updateArrowState = () => {
                if (currentSlide === 0) {
                    arrowLeft.hide();
                } else {
                    arrowLeft.show();
                }

                if (currentSlide >= thumbnails.length - visibleThumbnails) {
                    arrowRight.hide();
                } else {
                    arrowRight.show();
                }
            };

            thumbnails.click(function () {
                thumbnails.removeClass("active");
                $(this).addClass("active");
                updateVideoContent($(this));
            });

            // Enable dragging for the carousel
            thumbnailCarousel.on('mousedown touchstart', function (e) {
                isDragging = true;
                startX = e.pageX || e.originalEvent.touches[0].pageX;
                scrollLeft = thumbnailCarousel.scrollLeft();
                thumbnailCarousel.css('cursor', 'grabbing');
            });

            $(document).on('mousemove touchmove', function (e) {
                if (!isDragging) return;
                const x = e.pageX || e.originalEvent.touches[0].pageX;
                const walk = (startX - x) * 1.5; // Speed up the scroll
                thumbnailCarousel.scrollLeft(scrollLeft + walk);
            });

            $(document).on('mouseup touchend', function () {
                isDragging = false;
                thumbnailCarousel.css('cursor', 'grab');
            });

            arrowLeft.click(function () {
                if (currentSlide > 0) {
                    currentSlide--;
                    thumbnailCarousel.animate({ scrollLeft: currentSlide * thumbnailWidth }, 300);
                    updateArrowState();
                }
            });

            arrowRight.click(function () {
                if (currentSlide < thumbnails.length - visibleThumbnails) {
                    currentSlide++;
                    thumbnailCarousel.animate({ scrollLeft: currentSlide * thumbnailWidth }, 300);
                    updateArrowState();
                }
            });

            // Trigger click on the first thumbnail to initialize content
            thumbnails.first().click();
            updateArrowState();
        };


        // Initialize both sections
        handleMainArticlesSection3();
        handleMainArticlesSection2();
    });
</script>
{% endblock %}