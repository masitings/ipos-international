                                    {{  pimcore_wysiwyg("IPStartImgRippleContent3", {
                                            "placeholder" : "edit content 1..."
                                        })
                                    }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                    {{  pimcore_wysiwyg("IPCapQuestionContent2", {
                            "placeholder" : "edit content 3..."
                        })
                    }}
