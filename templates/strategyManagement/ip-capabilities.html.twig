<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector(".wrap-right-side-sticky");
        const sidebarContainer = document.querySelector(".col-lg-4.col-12.detail.right-side-contact");
        const mainContainer = document.querySelector(".main-articles");

        if (!sidebar || !sidebarContainer || !mainContainer) return;

        function updateStickySidebar() {
            const containerRect = sidebarContainer.getBoundingClientRect();
            const sidebarHeight = sidebar.offsetHeight;
            const containerHeight = sidebarContainer.offsetHeight;

            const offsetTop = mainContainer.offsetTop; // Top position of main container
            const stopPoint = offsetTop + containerHeight - sidebarHeight; // Bottom stop position

            if (window.scrollY > offsetTop - 322 && window.scrollY < stopPoint) {
                // Make sidebar fixed while scrolling
                sidebar.style.position = "fixed";
                sidebar.style.top = "280px";
                sidebar.style.bottom = "auto";
            } else if (window.scrollY >= stopPoint) {
                // Lock sidebar at the bottom of its container
                sidebar.style.position = "absolute";
                sidebar.style.top = "auto";
                sidebar.style.bottom = "156px";
            } else {
                // Reset when scrolling back up
                sidebar.style.position = "static";
                sidebar.style.top = "auto";
                sidebar.style.bottom = "auto";
            }
        }

        window.addEventListener("scroll", updateStickySidebar);
        window.addEventListener("resize", updateStickySidebar);
        updateStickySidebar(); // Initial run
    });


    $(document).ready(function () {
        let currentIndex = 0;
        const slides = $(".testimonial-slide");
        const slideCount = slides.length;
        const slideWidth = $(".testimonial-slide").outerWidth(true);
        const visibleSlides = 1.5;
        const track = $(".testimonial-track");
        const trackWidth = slideWidth * slideCount;
        track.css("width", trackWidth + "px");

        let isDragging = false;
        let startX = 0;
        let currentTranslate = 0;

        function updateSlides() {
            const offset = -(currentIndex * slideWidth);
            track.css("transform", `translateX(${offset}px)`);
            updateNavigationState();
        }

        function updateNavigationState() {
            $(".prev").prop("disabled", currentIndex === 0).toggleClass("disabled", currentIndex === 0);
            $(".next").prop("disabled", currentIndex >= slideCount - visibleSlides).toggleClass("disabled", currentIndex >= slideCount - visibleSlides);
        }

        $(".next").click(function () {
            if (currentIndex < slideCount - visibleSlides) {
                currentIndex++;
                updateSlides();
            }
        });

        $(".prev").click(function () {
            if (currentIndex > 0) {
                currentIndex--;
                updateSlides();
            }
        });

        track.on("mousedown touchstart", function (e) {
            isDragging = true;
            startX = e.type === "touchstart" ? e.touches[0].clientX : e.clientX;
        });

        $(document).on("mouseup touchend", function () {
            if (isDragging) {
                isDragging = false;
                const movedBy = currentTranslate - startX;
                if (movedBy < -50 && currentIndex < slideCount - visibleSlides) {
                    currentIndex++;
                } else if (movedBy > 50 && currentIndex > 0) {
                    currentIndex--;
                }
                updateSlides();
            }
        });

        $(document).on("mousemove touchmove", function (e) {
            if (!isDragging) return;
            const currentX = e.type === "touchmove" ? e.touches[0].clientX : e.clientX;
            currentTranslate = currentX;
        });

        // Initial state update
        updateNavigationState();
    });

