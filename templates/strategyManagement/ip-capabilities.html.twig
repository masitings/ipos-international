                    <div class="row">
                        <div class="col-12">
                            <div class="content_main_img img-strategy">
                                {% if editmode %}
                                    {{ pimcore_image("IPCapContentImageAfter") }}
                                {% else %}
                                    {% set thumbnail2 = pimcore_image("IPCapContentImageAfter") %}
                                    <img class="content_img" src="{{thumbnail2.getSrc()}}">
                                {% endif %} 
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 d-block d-md-none">
            </div>
            <div class="col-lg-4 col-12 detail right-side-contact">
