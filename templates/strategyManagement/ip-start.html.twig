{% extends template_layout_name %}

{% block content %}
<div class="articles_details_container resources_public_container ip-capabilities ip-start">
    <div class="bg_circle"></div>
    <div class="resources_public_title_nav container">
        <div class="row">
            <div class="col-12">
                <nav class="d-block nav-view" aria-label="breadcrumb" style="--bs-breadcrumb-divider: '&gt;';">
                        {% include('layouts/breadcrumb-col-12.html.twig') %}
                </nav>
            </div>
        </div>
    </div>

    <div class="container academy_enterprise_detail__page">
        <div class="row main-articles">
            <div class="col-lg-8 col-12 padding-right-90">
                <div class="header-part">
                    <h1>{{ pimcore_input('IPStartTitle',{'placeholder':'Welcome to IP Start'}) }}</h1>
                    <h3 style="
                        font-family: Rubik;
                        font-weight: 300;
                        font-size: 28px;
                        line-height: 36.4px;
                    ">{{ pimcore_input('IPStartSubTitle',{'placeholder':'Kick-start your start-up\'s IP journey!'}) }}</h3>
                </div>

                <div class="content-container ic-content">
                    <h3>{{ pimcore_input('IPStartContentTitle',{'placeholder':'Join our IP Start programme for start-ups'}) }}</h3>
                    <div>
                        {{  pimcore_wysiwyg("IPStartContent1", {
                                "placeholder" : "edit content 1..."
                            })
                        }}
                    </div>
                    <div class="gap-30"></div>
                    <h3>{{ pimcore_input('IPStartContentTitle2',{'placeholder':'Get answers to the top 3 IA/IP questions startups ask:'}) }}</h3>
                    <div>
                        <p>{{ pimcore_input('IPStartContent2',{'placeholder':'Your innovations fuel your business growth. Harness your innovations fully by managing your
                            intangible assets (“IA”) and intellectual property (“IP”):'}) }}</p>
                    </div>
                    <div class="ipos-timeline ip-questions-wrap">
                        <div class="timeline-item">
                            <div class="icon expand">
                                <div class="ripple-wrap"><span class="ripple"></span></div>
                                <div class="icon-inner">
                                    {{ pimcore_image("imgRipple1") }}
                                </div>
                            </div>
                            <div class="content">
                                <h3>{{ pimcore_input('IPStartImgRippleTitle1',{'placeholder':'How do I protect my technology and product?'}) }}</h3>
                                <div class="content-des">
                                    {{  pimcore_wysiwyg("IPStartImgRippleContent1", {
                                            "placeholder" : "edit content 1..."
                                        })
                                    }}
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="icon market">
                                <div class="ripple-wrap"><span class="ripple"></span></div>
                                <div class="icon-inner">
                                    {{ pimcore_image("imgRipple2") }}
                                </div>
                            </div>
                            <div class="content">
                                <h3>{{ pimcore_input('IPStartImgRippleTitle2',{'placeholder':'Go to market faster'}) }}</h3>
                                <div class="content-des">
                                    {{  pimcore_wysiwyg("IPStartImgRippleContent2", {
                                            "placeholder" : "edit content 1..."
                                        })
                                    }}
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="icon partner">
                                <div class="ripple-wrap"><span class="ripple"></span></div>
                                <div class="icon-inner">
                                    {{ pimcore_image("imgRipple3") }}
                                </div>
                            </div>
                            <div class="content">
                                <h3>{{ pimcore_input('IPStartImgRippleTitle3',{'placeholder': 'Partner effectively'}) }}</h3>
                                <div class="content-des">
                                    {{  pimcore_wysiwyg("IPStartImgRippleContent3", {
                                            "placeholder" : "edit content 1..."
                                        })
                                    }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <p>{{ pimcore_input('IPStartAfterImage',{'placeholder': 'We\'ve advised over 200 companies on IA and IP issues to date. We intimately understand how
                            start-ups can navigate these issues. IP Start will give you the head start you need to
                            manage your IA and IP, navigate obstacles, and prepare you for scaling.'}) }}</p>
                </div>
                <div class="m-b-30">
                    <h6 class="h6">{{ pimcore_input('IPStartBonusTitle',{'placeholder': 'Here\'s what you’ll get for FREE:'}) }}</h6>
                    <div class="m-b-15 m-t-15 point-wrap">
                        <ol>
                            <li>
                                <div class="d-flex align-items-center">
                                    <span class="m-r-20">
                                        {{ pimcore_image('IPStartBonus1') }}
                                    </span>
                                    <span>{{ pimcore_input('IPStartBonusTitle1',{'placeholder': '45-min consultation on your IA and IP'}) }}</span></div>
                            </li>
                            <li>
                                <div class="d-flex align-items-center">
                                <span class="m-r-20">
                                        {{ pimcore_image('IPStartBonus2') }}    
                                </span>
                                <span>{{ pimcore_input('IPStartBonusTitle2',{'placeholder': 'IP Essentials for Business course'}) }}</span></div>
                            </li>
                            <li>
                                <div class="d-flex align-items-center">
                                <span class="m-r-20">
                                        {{ pimcore_image('IPStartBonus3') }}    
                                </span>
                                <span>{{ pimcore_input('IPStartBonusTitle3',{'placeholder': 'IP Playbook for Start-ups'}) }}</span></div>
                            </li>
                            <li>
                                <div class="d-flex align-items-center">
                                <span class="m-r-20">
                                        {{ pimcore_image('IPStartBonus4') }}    
                                </span>
                                <span>{{ pimcore_input('IPStartBonusTitle4',{'placeholder': 'IP Playbook for Start-ups'}) }}</span></div>
                            </li>
                        </ol>
                    </div>
                </div>

                <div>
                    <div class="divider-content"></div>
                    <h3>{{ pimcore_input('IPStartCommunityTitle',{'placeholder': 'Join our community'}) }}</h3>
                    <p>{{ pimcore_input('IPStartCommunitySubTitle',{'placeholder': '
                        Be a part of our vibrant, growing community of start-ups, accelerators, and incubators today!
                        This is an invite-only programme for start-ups working with our partner accelerators.
